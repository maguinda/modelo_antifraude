__pycache__/
*.pyc
.venv/
.pytest_cache/

# Los datos se pueden volver a generar con los scripts de datos/generadores/ (semilla fija).
datos/*.csv
datos/*.csv.gz
!datos/dataset_antifraude_500_transacciones.csv

# Base de datos local del API (claves y evaluaciones): nunca se sube
api/datos_api.sqlite3*
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.migrar.lock

# Demo local: base y claves de demostración
api/demo/
api/certificados_locales/

# Despliegue: nunca se suben las variables reales, los secretos ni las copias de seguridad
despliegue/.env
despliegue/secretos/
despliegue/respaldos/
*.afbk

# Bases de ubicación de IP descargadas (se bajan con: python -m modelo_ia.api.ip_datos descargar; pesan decenas de MB y tienen sus propias licencias)
datos_ip/
