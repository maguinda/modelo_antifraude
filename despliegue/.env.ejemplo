# Copia este archivo como «.env» (en esta misma carpeta) y cambia los valores. NO pongas aquí secretos: esos van en la carpeta secretos/.
# El archivo .env está ignorado por git. Los valores de abajo son de ejemplo.

# Dirección pública del servicio (el dominio ya debe apuntar a la IP del servidor) y un correo para los avisos del certificado.
DOMINIO=antifraude.ejemplo.com
CORREO_ACME=admin@ejemplo.com

# HSTS en segundos. Empieza en 300 (5 minutos). Cuando todo esté probado: 86400 (1 día), luego 2592000 (30 días) y al final 31536000 (1 año).
HSTS_SEGUNDOS=300

# Política de contenido de /docs y las pantallas: «report-only» (solo observa) o «enforce» (bloquea). Pasa a enforce tras unos días sin avisos.
MODELO_IA_CSP=report-only

# Proveedor de IP. «simulado» NO ubica IP reales: sirve para probar el despliegue, no para evaluar pagos de verdad.
MODELO_IA_PROVEEDOR_IP=simulado

# Peticiones por minuto permitidas por clave de API.
MODELO_IA_LIMITE=600

# Cada cuántas horas se hace una copia de seguridad (y su límite para la vigilancia: un poco más del doble del intervalo cuenta como falla).
RESPALDO_CADA_HORAS=6
MODELO_IA_MAX_HORAS_RESPALDO=13

# Carpeta del servidor donde quedan las copias (debe pertenecer al usuario 10001: ver LEEME.md).
RESPALDOS_CARPETA=./respaldos

# Opcional: dirección https que recibe un aviso (JSON) cuando el estado del servicio cambia. Déjalo vacío si no usas ninguna.
MODELO_IA_ALERTA_URL=
